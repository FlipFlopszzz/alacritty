Windows Registry Editor Version 5.00

; Fork: register `al` for Win+R, pointing at the official install location
; that windows\dist.ps1 keeps updated with the fork build.
; Import: double-click this file, or `reg import al-app-path.reg`
; Remove: import al-remove.reg

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\App Paths\al.exe]
@="C:\\Program Files\\Alacritty\\alacritty.exe"
